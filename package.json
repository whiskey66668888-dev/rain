{
  "name": "multisite-spa",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:client:demo": "cross-env NODE_ENV=development BUILD_ENV=main SITE_ID=demo vite",
    "dev:client:op7": "cross-env NODE_ENV=development BUILD_ENV=sit SITE_ID=op7 vite",
    "uat:client:op7": "cross-env NODE_ENV=development BUILD_ENV=main SITE_ID=op7 vite",
    "dev:ssr:demo": "cross-env NODE_ENV=development BUILD_ENV=main SITE_ID=demo tsx src/server/server-dev.ts",
    "uat:ssr:op7": "cross-env NODE_ENV=development BUILD_ENV=main SITE_ID=op7 tsx src/server/server-dev.ts",
    "build:client:op7": "cross-env SITE_ID=op7 BUILD_TARGET=client BUILD_ENV=main NODE_ENV=production vite build",
    "build:server:op7": "cross-env SITE_ID=op7 BUILD_TARGET=server BUILD_ENV=main NODE_ENV=production vite build",
    "build:ssr:op7": "yarn build:client:op7 && yarn build:server:op7",
    "build:sit:client:op7": "cross-env SITE_ID=op7 BUILD_TARGET=client BUILD_ENV=sit NODE_ENV=production vite build",
    "build:sit:server:op7": "cross-env SITE_ID=op7 BUILD_TARGET=server BUILD_ENV=sit NODE_ENV=production vite build",
    "build:sit:ssr:op7": "yarn build:sit:client:op7 && yarn build:sit:server:op7",
    "prod:testssr:op7": "cd dist && cross-env BUILD_ENV=main NODE_ENV=production LOCAL_TEST=true SITE_ID=op7 node server-prod.js",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,md,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@fingerprintjs/fingerprintjs-pro": "^3.12.11",
    "@front-openim/wasm-client-sdk": "3.8.66",
    "@reduxjs/toolkit": "^2.11.1",
    "@sentry/node": "^10.38.0",
    "@sentry/react": "^10.35.0",
    "@tanstack/react-query": "^5.56.0",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/koa": "^3.0.1",
    "@types/koa-router": "^7.4.9",
    "@types/koa-static": "^4.0.4",
    "@types/pako": "^2.0.4",
    "@umengfe/apm": "^2.0.11",
    "ahooks": "^3.9.6",
    "antd-mobile": "^5.42.3",
    "axios": "^1.7.7",
    "big.js": "^7.0.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.19",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.0.0",
    "html2canvas": "1.0.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "js-cookie": "^3.0.5",
    "koa": "^3.1.1",
    "koa-compress": "^5.1.1",
    "koa-router": "^14.0.0",
    "koa-static": "^5.0.0",
    "lodash": "^4.17.21",
    "lottie-react": "^2.4.0",
    "pako": "^2.1.0",
    "react": "^19.2.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.0",
    "react-intersection-observer": "^10.0.2",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.0",
    "react-use-websocket": "^4.13.0",
    "react-window": "^1.8.10",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.5.0",
    "tiny-pinyin": "^1.3.2"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/file-saver": "^2",
    "@types/http-proxy-middleware": "^0.19.3",
    "@types/koa-compress": "^4.0.7",
    "@types/lodash": "^4.17.23",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@unocss/preset-attributify": "^66.5.10",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-rem-to-px": "^66.5.10",
    "@unocss/preset-uno": "^66.5.10",
    "@unocss/vite": "^66.5.10",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "open": "^11.0.0",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.3.3",
    "rollup-plugin-copy": "^3.5.0",
    "sass-embedded": "^1.93.3",
    "terser": "^5.48.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^7.3.5",
    "vite-plugin-css-modules": "^0.0.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-eslint": "^1.8.1"
  },
  "resolutions": {
    "esbuild": "^0.28.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "bash -c 'echo \"🔍 Type checking...\" && tsc --noEmit --pretty'",
      "prettier --write"
    ],
    "src/**/*.{scss,md,json}": [
      "prettier --write"
    ]
  },
  "volta": {
    "node": "20.19.0",
    "yarn": "1.22.22"
  }
}
