{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "./dist/server",
    "rootDir": "./src",
    "noEmit": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/server/**/*",
    "src/common/store/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/sites/**/*",
    "src/common/components/**/*",
    "src/common/pages/**/*",
    "src/common/pwa/**/*",
    "src/common/router/**/*",
    "src/core/**/*"
  ]
}

